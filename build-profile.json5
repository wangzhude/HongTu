{
  "app": {
    // 签名材料不入库（GPL 开源 + 机器特定）。signingConfigs 留空时构建产出
    // 未签名 HAP（CI / 代码验证可用）；真机/模拟器安装前请在 DevEco Studio:
    // File → Project Structure → Signing Configs → 勾选 "Automatically generate signature"
    // 一键生成后 IDE 会在本地回填 signingConfigs（勿提交回填后的密钥字段）。
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "targetSdkVersion": "26.0.0",
        "compileSdkVersion": "26.0.0",
        "compatibleSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": ["default"]
        }
      ]
    }
  ]
}
